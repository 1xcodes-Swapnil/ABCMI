# Copy this file to .env before running the app locally or via Docker Compose.
# Example:
#   cp .env.example .env
#
# For docker compose, the service hostnames are postgres, redis, and qdrant.
# For local non-container execution, use localhost instead of those names.

PROJECT_NAME="ABCI-MI Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

POSTGRES_SERVER="postgres"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="abcimi_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=15
DATABASE_HEALTH_TIMEOUT_SECONDS=10

ABCI_RUNTIME_ROOT=.runtime

REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=50

QDRANT_HOST="qdrant"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_HTTPS=false
QDRANT_TIMEOUT=10.0

AUDIO_STORAGE_PATH="./data/audio"
MAX_UPLOAD_SIZE_MB=500

EXECUTION_MODE="FIXTURE"
OPENMOSS_MODEL_ID="OpenMOSS-Team/MOSS-Transcribe-Diarize"
OPENMOSS_DEVICE="cpu"
OPENMOSS_PRECISION="nf4"
OPENMOSS_CACHE_DIR=""
SARVAM_QUANTIZED_MODEL_PATH=""
HF_TOKEN=""
HF_HOME=""
HUGGINGFACE_HUB_CACHE=""

SECRET_KEY="change-me-in-production"
JWT_SECRET_KEY="change-me-in-production"
JWT_ISSUER="abcimi-auth-service"
JWT_AUDIENCE="abcimi-api"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_TEST_TOKENS=true
AUTH_API_KEYS="[]"

GEMINI_API_KEY=""
TEXT_AI_PROVIDER="disabled"
GEMINI_MODEL="gemini-3.5-flash-lite"
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_INPUT_CHARACTERS=120000
GEMINI_MAX_OUTPUT_TOKENS=8192

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.com/api/v1/integrations/google_meet/callback"
GOOGLE_PROJECT_ID=""
GOOGLE_MEET_MEDIA_API_ENDPOINT=""
GOOGLE_MEET_ENABLED=false

MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="https://your-domain.com/api/v1/integrations/teams/callback"
TEAMS_BOT_ENDPOINT=""
TEAMS_MEDIA_BOT_ENABLED=false

RUN_REAL_GOOGLE_MEET_E2E=false
RUN_REAL_TEAMS_E2E=false

AUDIO_CHUNK_DURATION_SECONDS=8.0
AUDIO_CHUNK_OVERLAP_SECONDS=3.0
AUDIO_CHUNK_THRESHOLD_SECONDS=8.0
AUDIO_CHUNK_CONCURRENCY=1
PYANNOTE_WINDOW_SECONDS=30.0
PYANNOTE_WINDOW_OVERLAP_SECONDS=5.0
PYANNOTE_SPEAKER_MATCH_THRESHOLD=0.75
