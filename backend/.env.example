# ==============================================================================
# ABCI-MI (Adaptive Blackboard & Collaboration Intelligence for Multilingual Interaction)
# Backend Environment Configuration
# ==============================================================================

# Application & Runtime
PROJECT_NAME="ABCI-MI Backend API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["*"]

# PostgreSQL Database Configuration
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="abcimi_db"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
# Optional explicit full database URLs (if unset, computed from above)
# DATABASE_URL_ASYNC="postgresql+asyncpg://postgres:postgres_password@localhost:5432/abcimi_db"
# DATABASE_URL_SYNC="postgresql+psycopg2://postgres:postgres_password@localhost:5432/abcimi_db"

# Redis Configuration (Cache, Transient State, Event Bus)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_SOCKET_TIMEOUT=5.0
REDIS_MAX_CONNECTIONS=50
# Optional explicit Redis URL (if unset, computed from above)
# REDIS_URL="redis://localhost:6379/0"

# Qdrant Vector Storage Configuration (Semantic Memory & Workspace)
QDRANT_HOST="localhost"
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=""
QDRANT_HTTPS=false
QDRANT_TIMEOUT=10.0
# Optional explicit Qdrant URL (if unset, computed from above)
# QDRANT_URL="http://localhost:6333"

# Audio & Artifact Storage Configuration
AUDIO_STORAGE_PATH="./data/audio"
MAX_UPLOAD_SIZE_MB=500

# AI Pipeline & Model Configuration (Phase 4.26)
EXECUTION_MODE="FIXTURE" # Options: REAL, FIXTURE, MOCK
OPENMOSS_MODEL_ID="OpenMOSS-Team/MOSS-Transcribe-Diarize"
OPENMOSS_DEVICE="cpu" # Options: cpu, cuda, auto
OPENMOSS_CACHE_DIR="" # Optional HuggingFace cache directory override
HF_TOKEN="" # Optional HuggingFace Token for auth (e.g. for PyAnnote)
AUDIO_CHUNK_DURATION_SECONDS=600.0 # 10 minutes chunk duration
AUDIO_CHUNK_OVERLAP_SECONDS=30.0   # 30 seconds overlap window
AUDIO_CHUNK_THRESHOLD_SECONDS=600.0 # Audio duration threshold to trigger chunking
AUDIO_CHUNK_CONCURRENCY=1          # Bounded concurrency (default 1 sequential)

# Security Foundation (Token signing & verification)
SECRET_KEY="replace-this-with-a-secure-random-32-byte-secret-key-in-production"
JWT_SECRET_KEY="replace-with-dedicated-jwt-secret-key-in-production"
JWT_ISSUER="abcimi-auth-service"
JWT_AUDIENCE="abcimi-api"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOW_TEST_TOKENS=false
AUTH_API_KEYS="[]"

# Optional External AI & Integration Providers
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ZOOM_WEBHOOK_SECRET=""
TEAMS_WEBHOOK_SECRET=""
MEET_WEBHOOK_SECRET=""
WEBEX_WEBHOOK_SECRET=""

# Google Workspace & Google Meet Integration
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://your-domain.com/api/v1/integrations/google_meet/callback"
GOOGLE_PROJECT_ID=""
GOOGLE_MEET_MEDIA_API_ENDPOINT=""
GOOGLE_MEET_ENABLED=true

# Microsoft 365 & Microsoft Teams Integration
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID=""
MICROSOFT_REDIRECT_URI="https://your-domain.com/api/v1/integrations/teams/callback"
TEAMS_BOT_ENDPOINT=""
TEAMS_MEDIA_BOT_ENABLED=false

# Real Provider E2E Test Execution Flags
RUN_REAL_GOOGLE_MEET_E2E=false
RUN_REAL_TEAMS_E2E=false
